{
    "name": "patchdashboard/api",
    "description": "PatchDashboard v2 REST API",
    "type": "project",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "firebase/php-jwt": "^6.11",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.9",
        "php-di/php-di": "^7.0",
        "predis/predis": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "PatchDashboard\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PatchDashboard\\Api\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public public/index.php"
    }
}
