APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_HOST=mysql
DB_PORT=3306
DB_NAME=patchdashboard
DB_USER=patchdashboard
DB_PASS=patchdashboard

JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=86400

# Optional: encrypt stored TOTP secrets (defaults to JWT_SECRET if unset)
# MFA_ENCRYPTION_KEY=

PW_SALT=legacy-salt-for-sha256-migration
YOUR_COMPANY=Test, INC

CORS_ORIGIN=http://localhost:5173

MAIL_FROM=alerts@patchdashboard.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: auto-register a Slack incoming webhook (hooks.slack.com/services/...)
SLACK_WEBHOOK_URL=
SLACK_USERNAME=PatchDashboard
# Optional: NVD API key (recommended for bulk CVE sync rate limits)
NVD_API_KEY=

# Optional: GitHub token for advisory API rate limits
GITHUB_TOKEN=

# CVE sync CLI memory limit (OSV zip parsing; download is streamed to disk)
# CVE_SYNC_MEMORY_LIMIT=512M

# Web SSH console (Node WebSocket service; sessions stored in Redis)
CONSOLE_WS_PUBLIC_URL=ws://localhost:8090
CONSOLE_DEV_STUB=true

# Redis (console sessions and future shared cache)
REDIS_URL=redis://redis:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Optional: internal API validation for console (fallback; console reads Redis directly)
CONSOLE_INTERNAL_SECRET=
