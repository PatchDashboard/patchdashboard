# PatchDashboard production Docker environment
# Copy to .env and edit before: docker compose -f docker-compose.prod.yml up -d

COMPOSE_PROJECT_NAME=patchdashboard

# Public URL used for APP_URL, CORS, and setup links
PUBLIC_URL=http://localhost

# Host port published by the web (nginx) service
HTTP_PORT=80

# MariaDB
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=patchdashboard
MARIADB_USER=patchdashboard
MARIADB_PASSWORD=change-me-db

# API secrets (generate strong random values for production)
JWT_SECRET=change-me-jwt-secret
PW_SALT=change-me-legacy-salt
YOUR_COMPANY=Pending setup

# Mail / alerts (optional)
MAIL_FROM=alerts@patchdashboard.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Slack incoming webhook (optional — auto-registers on Alerts page load)
SLACK_WEBHOOK_URL=
SLACK_USERNAME=PatchDashboard
SLACK_ICON_URL=

# Redis (shared session store)
REDIS_URL=redis://redis:6379

# Web SSH console
CONSOLE_WS_PUBLIC_URL=ws://localhost/ws-console
CONSOLE_DEV_STUB=false

# Optional: encrypt stored TOTP secrets (defaults to JWT_SECRET)
# MFA_ENCRYPTION_KEY=

# CVE feed sync (optional)
# NVD_API_KEY=
# CVE_SYNC_MEMORY_LIMIT=512M
